# Zkopírujte do .env (nebo zadejte v nastavení hostingu). Nic z toho nepatří do gitu.

PORT=3000
PUBLIC_URL=https://karta.e-bistro.cz
SITE_URL=https://e-bistro.cz
DATABASE_URL=postgres://uzivatel:heslo@server:5432/vernost

# Náhodný text aspoň 32 znaků (např. `openssl rand -hex 32`)
SESSION_SECRET=
# Heslo do administrace /admin
ADMIN_PASSWORD=

# Pravidla programu
STAMPS_GOAL=8
REWARD_TEXT=Jídlo zdarma
REWARD_DETAIL=libovolné hlavní jídlo z nabídky

# Apple Wallet (z developer.apple.com)
APPLE_TEAM_ID=
APPLE_PASS_TYPE_ID=pass.cz.ebistro.vernost
# PEM text (zalomení jako \n), nebo cesta k souboru přes *_FILE
APPLE_PASS_CERT_FILE=certs/pass.pem
APPLE_PASS_KEY_FILE=certs/pass.key
APPLE_WWDR_CERT_FILE=certs/wwdr.pem

# Google Peněženka (nepovinné)
GOOGLE_ISSUER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_FILE=
